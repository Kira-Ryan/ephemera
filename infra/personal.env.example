# Copy to infra/personal.env (gitignored) and fill in. NEVER put an employer credential or
# account ID in this file - the guards refuse anything not listed here, and refuse empty lists.

# --- AWS (guard.sh) ---
# The named CLI profile for the PERSONAL account. Required: this machine's default profile is an
# employer account, and the guard pins AWS_PROFILE to this before any API call.
EPHEMERA_AWS_PROFILE=""
# Space-separated allowlist of PERSONAL account IDs.
EPHEMERA_AWS_ACCOUNT_IDS=""
# Space-separated forbidden IDs (employer accounts). A match refuses even if allowlisted by mistake.
EPHEMERA_AWS_FORBIDDEN_IDS=""

# --- Cloudflare (guard_cf.sh) - the PERSONAL account (kiraryan27@gmail.com), never an employer account ---
# Token: dash.cloudflare.com -> My Profile -> API Tokens -> Create Custom Token with
#   Account / Cloudflare Pages / Edit,  Zone / Zone / Read,  Zone / DNS / Edit
# scoped to the personal account and the ephemera.space zone.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
EPHEMERA_CF_ACCOUNT_IDS=""

# --- Cloudflare R2 (infra/r2_packs.py) - the globe packs, kept out of git (D08) ---
# R2 > Overview > Create bucket, then the bucket's Settings tab for the custom domain and a CORS
# policy allowing https://ephemera.space with GET and HEAD. The API token is created under
# R2 > API > Manage API Tokens with "Object Read and Write"; it deliberately cannot create buckets.
# R2_ACCOUNT_ID must also appear in EPHEMERA_CF_ACCOUNT_IDS above, or r2_packs refuses.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET=""
# The public hostname the site links. Without it r2_packs refuses rather than guess a vendor host.
R2_PUBLIC_HOST=""

# --- archive.org Save Page Now 2 (archive/witness.py) ---
# The witness currently uses the UNAUTHENTICATED browser endpoint, which has returned HTTP 500 to
# this machine for every URL since 13 Sep 2026, so no cycle since then has an independent copy.
# Authenticated SPN2 is a different API: POST https://web.archive.org/save with an Authorization
# header, then poll a job id. Limits for an authenticated account are 12 concurrent captures,
# 100,000 a day and 10 per URL a day, against roughly 8 rapid captures unauthenticated.
# Keys: sign in at https://archive.org/account/login then generate a pair at
# https://archive.org/account/s3.php ("Generate New Keys"). They are account-wide, so treat the
# secret like any other credential here: this file only, never committed.
ARCHIVE_ORG_ACCESS_KEY=""
ARCHIVE_ORG_SECRET_KEY=""
