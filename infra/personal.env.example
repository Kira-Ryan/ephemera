# Copy to infra/personal.env (gitignored) and fill in. NEVER put another credential or
# account ID in this file - the guards refuse anything not listed here, and refuse empty lists.

# --- AWS (guard.sh) ---
# The named CLI profile for the PERSONAL account. Required: this machine's default profile is a
# different account, and the guard pins AWS_PROFILE to this before any API call.
EPHEMERA_AWS_PROFILE=""
# Space-separated allowlist of PERSONAL account IDs.
EPHEMERA_AWS_ACCOUNT_IDS=""
# Space-separated forbidden IDs (other accounts). A match refuses even if allowlisted by mistake.
EPHEMERA_AWS_FORBIDDEN_IDS=""

# --- Cloudflare (guard_cf.sh) - the PERSONAL account (kiraryan27@gmail.com), never another account ---
# Token: dash.cloudflare.com -> My Profile -> API Tokens -> Create Custom Token with
#   Account / Cloudflare Pages / Edit,  Zone / Zone / Read,  Zone / DNS / Edit
# scoped to the personal account and the ephemera.space zone.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
EPHEMERA_CF_ACCOUNT_IDS=""
