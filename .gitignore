node_modules/
dist/
# ... but the deployable site IS tracked (push-to-deploy checks it out on the runner):
!web/dist/
!web/dist/**
.claude/settings.local.json
__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store

# Raw operator files. Archived on cold object storage with published hashes — NEVER committed.
data/raw/
archive/spool/
**/heartbeat.json

# Probe working files — full-cycle pulls run to tens of GB.
probes/**/pull/
probes/**/*.gz

# Account-specific environment (personal account ids, bucket names, tokens) — local only.
infra/*.env
*.secret

# The VPS runbook (DOCS/migration-runbook.md) now keeps credentials outside the checkout, but
# these are the paths a reader following an older draft, or anyone working by hand on the host,
# would reach for first. This repository is public, so an AWS credentials file or an SSH private
# key landing here must never be offerable to git in the first place.
/.aws/
/.ssh/

# Wrangler's isolated home for guarded deploys (never the machine-level OAuth config)
.wrangler-home/

# Derived score and globe products written by web/build.py runs done by hand.
# The spool under Z: is the store of record; nothing here needs committing.
data/
